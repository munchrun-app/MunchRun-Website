{
  "name": "munchrun-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run ensure-platform-deps && vite",
    "deploy": "npm run ensure-platform-deps && npm run build",
    "build": "npm run generate-sitemap && NODE_OPTIONS=\"--max-old-space-size=4096\" vite build",
    "ensure-platform-deps": "node src/scripts/ensure-platform-deps.js",
    "preview": "vite preview",
    "generate-sitemap": "node src/scripts/generate-sitemap.cjs",
    "standard": "standard --fix"
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.0.6",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^7.1.3",
    "tailwindcss": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "gh-pages": "^6.3.0",
    "globals": "^15.14.0",
    "standard": "^17.1.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "rollup": {
      "@rollup/rollup-linux-x64-gnu": "npm:@rollup/rollup-darwin-x64@latest",
      "@rollup/rollup-linux-x64-musl": "npm:@rollup/rollup-darwin-x64@latest"
    }
  }
}